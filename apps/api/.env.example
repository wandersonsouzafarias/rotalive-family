DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rotalive_family?schema=public"

# auto | local | supabase
# auto = detecta Supabase placeholder e usa local automaticamente
AUTH_PROVIDER=auto

# Obrigatório em AUTH_PROVIDER=local (ou auto com Supabase placeholder)
JWT_SECRET="rotalive-dev-secret-change-before-production"

# Obrigatório em AUTH_PROVIDER=supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

API_PORT=3001
CORS_ORIGIN="http://localhost:3000"
